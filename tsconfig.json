{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2017", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@figma"
    ]
  },
  "include": ["code.ts", "src/**/*"],
  "exclude": ["scratch_test", "vitest.config.ts"]
}
